# Viết chương trình in ra các số nguyên tố từ 1 đến n:
import sys
def liet_ke_so_nguyen_to_den_n(gia_tri_n):
    if gia_tri_n < 2:
        return []
    danh_dau = [True] * (gia_tri_n + 1)
    danh_dau[0] = False
    danh_dau[1] = False
    so_hien_tai = 2
    while so_hien_tai * so_hien_tai <= gia_tri_n:
        if danh_dau[so_hien_tai]:
            for boi_so in range(so_hien_tai * so_hien_tai, gia_tri_n + 1, so_hien_tai):
                danh_dau[boi_so] = False
        so_hien_tai += 1
    return [chi_so for chi_so, la_nguyen_to in enumerate(danh_dau) if la_nguyen_to]
def chuong_trinh_chinh():
    try:
        gia_tri_n = int(input())
    except:
        sys.exit()
    for so_nguyen_to in liet_ke_so_nguyen_to_den_n(gia_tri_n):
        print(so_nguyen_to)
if __name__ == "__main__":
    chuong_trinh_chinh()
